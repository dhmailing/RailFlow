<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          접근성 서비스. 읽기 전용이다(res/xml/rail_observer_config.xml).
          intent-filter 가 있으므로 exported 를 명시한다.
        -->
        <service
            android:name="com.railflow.observer.RailObserverService"
            android:exported="true"
            android:label="@string/observer_service_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rail_observer_config" />
        </service>
    </application>

</manifest>
