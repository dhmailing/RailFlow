# 국토교통부 TAGO 열차정보 API의 일반 인증키(Decoding)를 사용합니다.
# 실제 값은 소스에 저장하지 말고 호스팅 환경의 비밀값으로 등록하세요.
DATA_GO_KR_SERVICE_KEY=

# --- v0.4 예약 작업 기반(안전 기본값: 모두 비활성화) ---
# 시간표·운임 조회 Provider. tago(기본값) 또는 mock.
RAIL_SCHEDULE_PROVIDER=tago
# 예약 작업 Provider. disabled(기본값)|mock|official. official은 Stub이며 실제 요청을 보내지 않습니다.
RAIL_RESERVATION_PROVIDER=disabled
# 예약 작업 생성·진행(Queue/Worker) 기능 자체의 kill switch. false가 기본값입니다.
ENABLE_RESERVATION_JOBS=false
# 1~5초 "Mock 작업 시뮬레이션 간격" 개발용 UI 노출 여부. NODE_ENV=production에서는 값과 무관하게 항상 거부됩니다.
ENABLE_MOCK_SIMULATION=false
# 이 값은 참고용입니다. 코드에서는 항상 false로 취급하며 이 변수를 읽지 않습니다.
ALLOW_LIVE_RESERVATION=false

# --- v0.5 취소표 감시 기반(안전 기본값: 모두 비활성화) ---
# 잔여좌석 Provider. disabled(기본값)|mock. disabled면 모든 감시 작업이
# PROVIDER_UNAVAILABLE 상태로 정직하게 표시됩니다(실제 좌석 조회 없음).
SEAT_AVAILABILITY_PROVIDER=disabled
# 취소표 감시 작업 생성·진행(Queue/Worker) 기능 자체의 kill switch. false가 기본값입니다.
ENABLE_SEAT_WATCH_JOBS=false
# Mock 취소표 시뮬레이션(검증값 1~5) 개발용 UI 노출 여부. NODE_ENV=production에서는
# 값과 무관하게 항상 거부됩니다.
ENABLE_MOCK_SEAT_SIMULATION=false

# --- 계정·감시 작업 저장소 선택 (v0.5 검토 후 추가, 안전 기본값: 모두 disabled) ---
# 계정(회원가입/로그인/세션) 저장소. disabled(기본값)|memory|postgres.
# - disabled: 회원가입/로그인/계정삭제/인증 기반 API가 모두 503으로 거부됩니다.
# - memory: 개발/테스트 전용 인메모리 저장소를 사용합니다. NODE_ENV=production에서는
#   이 값을 memory로 설정해도 항상 disabled처럼 동작합니다(Vercel Serverless는
#   인스턴스마다 별도 메모리를 가져 실제 계정 시스템으로 쓸 수 없기 때문).
# - postgres: 아직 이 PR에는 실제 구현이 없습니다(db/postgres/는 설계 문서만 존재).
#   선택은 가능하지만 실제로는 사용되지 않습니다.
AUTH_STORE=disabled
# 취소표 감시 작업/기기 저장소. AUTH_STORE와 동일한 값·동일한 이유의 독립적인
# fail-closed 플래그입니다(계정 저장소가 나중에 postgres가 되어도 감시 작업
# 저장소가 여전히 memory라면 이 플래그가 따로 막습니다).
WATCH_STORE=disabled

# 운영(Production)에서 CSRF 방어(Origin 검증)에 사용하는 이 배포의 정확한
# origin(scheme://host[:port], 경로 없음) 값입니다. 예: https://railflow.example.com
# NODE_ENV=production에서 이 값이 없거나 형식이 잘못되면 회원가입/로그인/
# 로그아웃/계정삭제/기기등록/감시작업 생성·취소·재감시·예매확인 등 쿠키로
# 인증되는 모든 상태 변경 요청이 거부됩니다(lib/security/origin-guard.ts).
# 개발/테스트(NODE_ENV≠production)에서는 읽지 않습니다.
# 주의: Vercel Preview 배포는 매번 URL이 달라지므로 Production과 같은 값을
# 쓸 수 없습니다 -- Preview에서 실제 인증을 켜려면 그 환경 전용의 안정적인
# APP_ORIGIN을 별도로 등록해야 합니다.
# APP_ORIGIN=https://railflow.example.com

# 아래는 db/postgres/migrations의 스키마를 실제로 연결할 때만 필요합니다.
# 이번 PR에는 이 값을 읽는 코드가 없습니다(설계 문서 참고용).
# DATABASE_URL=postgres://user:password@host:5432/railflow

# --- v0.7 자동 좌석조회·예약 매크로 시뮬레이터(안전 기본값: 모두 비활성화) ---
# 자동화 Provider. unavailable(기본값)|mock-browser|official.
# - unavailable: 모든 자동화 작업이 PROVIDER_UNAVAILABLE로 정직하게 거부됩니다.
# - mock-browser: RailFlow 자체 Mock 예매 사이트(/demo/booking-simulator)만
#   Playwright로 조작합니다. 외부 철도 사이트는 절대 대상이 될 수 없습니다
#   (lib/automation/host-guard.ts의 허용목록 강제). NODE_ENV/VERCEL_ENV가
#   운영(Production)이면 이 값과 무관하게 항상 unavailable처럼 동작합니다.
# - official: 아직 Stub입니다(외부 요청 없음, 항상 NOT_CONFIGURED 거부).
SEAT_AUTOMATION_PROVIDER=unavailable
# 자동 좌석조회·예약 매크로 작업(자동예약 탭) 생성·진행 기능 자체의 kill switch.
# false가 기본값입니다.
ENABLE_SEAT_AUTOMATION_JOBS=false
# Mock 예매 사이트(/demo/booking-simulator) 자체의 노출 여부. 자동화 작업
# kill switch와 독립적으로, 사람이 직접 둘러볼 수 있게 하는 값입니다.
# 운영(VERCEL_ENV=production)에서는 값과 무관하게 항상 꺼집니다.
ENABLE_MOCK_BOOKING_SITE=false
# SEAT_FOUND -> PURCHASE_CLICKING -> RESERVING 구간의 작업 스텝 소유권(Claim)
# 임대 시간(ms). 기본 20000. 운영(Production)에서는 이 값을 무시하고 항상
# 기본값을 사용합니다(임의로 늘려 잠금을 우회하지 못하도록).
AUTOMATION_STEP_LEASE_MS=20000
# mock-browser Provider가 내부적으로 목표 URL을 구성할 때 쓰는 기준 주소입니다.
# 이 값은 참고용 fallback일 뿐이며, 실제로 브라우저가 이동하기 전/후 항상
# lib/automation/host-guard.ts의 허용목록(localhost 또는 이 배포 자신의
# VERCEL_URL)으로 재검증됩니다 -- 이 값을 외부 주소로 바꿔도 우회되지 않습니다.
# AUTOMATION_TARGET_BASE_URL=http://localhost:3000
# 로컬 개발 환경에 Playwright가 기대하는 기본 경로와 다른 위치에 Chromium이
# 설치되어 있을 때만 지정합니다. 비워두면 이 저장소가 검증한 샌드박스 경로
# (/opt/pw-browsers/chromium)를 사용합니다.
# PLAYWRIGHT_CHROMIUM_PATH=

